/**
 * secrets.h.example - Template for external credentials
 * 
 * 1. Copy this file to secrets.h
 * 2. Fill in your actual credentials
 * 3. NEVER commit secrets.h to version control
 */

#ifndef SECRETS_H
#define SECRETS_H

// WiFi Credentials
#define WIFI_SSID "your_wifi_network"
#define WIFI_PASSWORD "your_wifi_password"

// ----------------------------------------------------------------------------
// Environment Selection
// ----------------------------------------------------------------------------
#define USE_LOCAL_MQTT 1 // Set to 1 for local docker testing, 0 for production

// ----------------------------------------------------------------------------
// MQTT Broker Credentials
// ----------------------------------------------------------------------------
#if USE_LOCAL_MQTT
  // Local Proxy WSS (self-signed cert, mqtt.local host)
  #define MQTT_BROKER_ADDR "mqtt.local"
  #define MQTT_BROKER_PORT 443
  #define MQTT_BROKER_USER "tl4k_device"
  #define MQTT_BROKER_PASS "tl4k_mqtt_2026_prod_secure" // Default dev password
  #define MQTT_SKIP_CERTIFICATE_VALIDATION true         // Ignore CA for local self-signed cert
#else
  // Production WSS (Let's Encrypt cert, mqtt.techlab4kids.info host)
  #define MQTT_BROKER_ADDR "mqtt.techlab4kids.info"
  #define MQTT_BROKER_PORT 443
  #define MQTT_BROKER_USER ""
  #define MQTT_BROKER_PASS ""
  // CA validation is active by default (MQTT_SKIP_CERTIFICATE_VALIDATION = false)
#endif

// Optional: Flespi token (if using flespi.io)
// #define MQTT_FLESPI_TOKEN "FlespiToken YOUR_TOKEN_HERE"

#endif // SECRETS_H
